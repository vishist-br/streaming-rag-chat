# Copy to .env and fill in. Never commit .env.

# "gemini" uses the Gemini API. "local" is an offline demo provider (hashed
# embeddings + extractive answers, no LLM) so the app runs without a key.
PROVIDER=gemini
GEMINI_API_KEY=

# Models (see backend/app/config.py for every tunable and its default)
GENERATION_MODEL=gemini-3.8-flash
FAST_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-2

# Postgres (docker-compose wires these up for you)
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag

# Browser -> backend URL, baked into the frontend bundle at build time
NEXT_PUBLIC_API_URL=http://localhost:8000
