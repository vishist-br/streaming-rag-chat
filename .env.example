# Copy to .env and fill in. Never commit .env.

# "gemini" uses the Gemini API.
# "ollama" uses real open models running on your machine (no key, no cost).
# "local"  is an offline demo provider (hashed embeddings + extractive answers,
#          no LLM) used by CI and for a zero-setup demo.
PROVIDER=gemini
GEMINI_API_KEY=

# Models (see backend/app/config.py for every tunable and its default)
GENERATION_MODEL=gemini-3.8-flash
FAST_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-2

# Ollama (only used when PROVIDER=ollama). Pull the models first:
#   ollama pull llama3.2 && ollama pull nomic-embed-text
# Inside docker-compose the backend reaches Ollama on the host via host.docker.internal.
OLLAMA_GENERATION_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Postgres (docker-compose wires these up for you)
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag

# Browser -> backend URL, baked into the frontend bundle at build time
NEXT_PUBLIC_API_URL=http://localhost:8000
